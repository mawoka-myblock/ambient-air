(module Footprint (layer F.Cu) (tedit 61218795)
  (attr smd)
  (descr "Footprint StepUp generated footprint")
  (fp_text reference "REF**" (at 0.0 -17.0) (layer F.SilkS)
  (effects (font (size 1.0 1.0) (thickness 0.150)))
  )
  (fp_text value "Value " (at 11.0 9.0) (layer F.SilkS)
    (effects (font (size 0.8 0.8) (thickness 0.120)))
  )
  (fp_text user %R (at 0.0 -17.0) (layer F.Fab)
    (effects (font (size 1.0 1.0) (thickness 0.150)))
  )
  (fp_text user "EDIT PAD NUMBERS" (at 11.0 8.0) (layer Cmts.User)
    (effects (font (size 1 1) (thickness 0.2) italic))
  )
  (fp_line (start -1.500000 2.000000) (end 1.500000 2.000000) (layer F.Fab) (width 0.1))
  (fp_line (start 1.500000 2.000000) (end 1.500000 -2.000000) (layer F.Fab) (width 0.1))
  (fp_line (start 1.500000 -2.000000) (end -1.500000 -2.000000) (layer F.Fab) (width 0.1))
  (fp_line (start -1.500000 -2.000000) (end -1.500000 2.000000) (layer F.Fab) (width 0.1))
  (fp_line (start 1.700000 2.200000) (end 1.700000 -2.200000) (layer F.SilkS) (width 0.16))
  (fp_line (start 1.700000 -2.200000) (end -1.700000 -2.200000) (layer F.SilkS) (width 0.16))
  (fp_line (start -1.700000 -2.200000) (end -1.700000 2.200000) (layer F.SilkS) (width 0.16))
  (fp_line (start -1.700000 2.200000) (end 1.700000 2.200000) (layer F.SilkS) (width 0.16))
  (fp_line (start -1.417157 -2.482843) (end -1.982843 -1.917157) (layer F.SilkS) (width 0.16))
  (pad "#" smd rect (at 0.000 -1.525) (size 0.850 0.850)  (layers F.Cu F.Paste F.Mask))
  (pad "#" smd rect (at 0.000 1.525) (size 0.850 0.850)  (layers F.Cu F.Paste F.Mask))
  (pad "#" smd rect (at -1.020 1.150) (size 0.850 0.850)  (layers F.Cu F.Paste F.Mask))
  (pad "#" smd rect (at -1.020 -0.000) (size 0.850 0.850)  (layers F.Cu F.Paste F.Mask))

   (model "/var/home/mawoka/projects/ambient-air/Footprint.wrl"
